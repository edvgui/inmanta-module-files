{#- Write the free-form directives of a section -#}
{%- macro extra(section) %}
{#- Index the dict instead of using items(), to get null values converted to none -#}
{%- for key in section.extra %}
{{- key | files.systemd_unit.directive(section.extra[key]) }}
{%- endfor %}
{%- endmacro %}

{%- if unit_file.unit is defined -%}
{%- set unit = unit_file.unit -%}
[Unit]
{{- "Description" | files.systemd_unit.directive(unit.description) }}
{{- "Documentation" | files.systemd_unit.directive(unit.documentation, joined=true) }}
{{- "RequiresMountsFor" | files.systemd_unit.directive(unit.requires_mounts_for, joined=true, quoted=true) }}
{{- "Requires" | files.systemd_unit.directive(unit.requires) }}
{{- "Wants" | files.systemd_unit.directive(unit.wants) }}
{{- "BindsTo" | files.systemd_unit.directive(unit.binds_to) }}
{{- "Conflicts" | files.systemd_unit.directive(unit.conflicts) }}
{{- "Before" | files.systemd_unit.directive(unit.before) }}
{{- "After" | files.systemd_unit.directive(unit.after) }}
{{- "PartOf" | files.systemd_unit.directive(unit.part_of) }}
{{- "OnFailure" | files.systemd_unit.directive(unit.on_failure, joined=true) }}
{{- "StartLimitIntervalSec" | files.systemd_unit.directive(unit.start_limit_interval_sec) }}
{{- "StartLimitBurst" | files.systemd_unit.directive(unit.start_limit_burst) }}
{{- extra(unit) }}

{% endif -%}

{%- if unit_file.service is defined -%}
{%- set service = unit_file.service -%}
[Service]
{%- for name in service.environment %}
Environment={{ name | files.systemd_unit.environment(service.environment[name]) }}
{%- endfor %}
{{- "EnvironmentFile" | files.systemd_unit.directive(service.environment_file) }}
{{- "User" | files.systemd_unit.directive(service.user) }}
{{- "Group" | files.systemd_unit.directive(service.group) }}
{{- "WorkingDirectory" | files.systemd_unit.directive(service.working_directory) }}
{{- "Restart" | files.systemd_unit.directive(service.restart) }}
{{- "TimeoutStartSec" | files.systemd_unit.directive(service.timeout_start_sec) }}
{{- "TimeoutSec" | files.systemd_unit.directive(service.timeout_sec) }}
{{- "TimeoutStopSec" | files.systemd_unit.directive(service.timeout_stop_sec) }}
{{- "RestartSec" | files.systemd_unit.directive(service.restart_sec) }}
{{- "ExecStartPre" | files.systemd_unit.directive(service.exec_start_pre) }}
{{- "ExecStart" | files.systemd_unit.directive(service.exec_start) }}
{{- "ExecStartPost" | files.systemd_unit.directive(service.exec_start_post) }}
{{- "ExecReload" | files.systemd_unit.directive(service.exec_reload) }}
{{- "ExecStop" | files.systemd_unit.directive(service.exec_stop) }}
{{- "ExecStopPost" | files.systemd_unit.directive(service.exec_stop_post) }}
{{- "Type" | files.systemd_unit.directive(service.type) }}
{{- "RemainAfterExit" | files.systemd_unit.directive(service.remain_after_exit) }}
{{- "NotifyAccess" | files.systemd_unit.directive(service.notify_access) }}
{{- "PIDFile" | files.systemd_unit.directive(service.pid_file) }}
{{- "KillMode" | files.systemd_unit.directive(service.kill_mode) }}
{{- "SuccessExitStatus" | files.systemd_unit.directive(service.success_exit_status or none, joined=true) }}
{{- extra(service) }}

{% endif -%}

{% if unit_file.timer is defined -%}
{%- set timer = unit_file.timer -%}
[Timer]
{{- "OnCalendar" | files.systemd_unit.directive(timer.on_calendar) }}
{{- "OnBootSec" | files.systemd_unit.directive(timer.on_boot_sec) }}
{{- "OnUnitActiveSec" | files.systemd_unit.directive(timer.on_unit_active_sec) }}
{{- "AccuracySec" | files.systemd_unit.directive(timer.accuracy_sec) }}
{{- "RandomizedDelaySec" | files.systemd_unit.directive(timer.randomized_delay_sec) }}
{{- "Persistent" | files.systemd_unit.directive(timer.persistent) }}
{{- "Unit" | files.systemd_unit.directive(timer.unit) }}
{{- extra(timer) }}

{% endif -%}

{% if unit_file.socket is defined -%}
{%- set socket = unit_file.socket -%}
[Socket]
{{- "ListenStream" | files.systemd_unit.directive(socket.listen_stream) }}
{{- "ListenDatagram" | files.systemd_unit.directive(socket.listen_datagram) }}
{{- "Accept" | files.systemd_unit.directive(socket.accept) }}
{{- "SocketMode" | files.systemd_unit.directive(socket.socket_mode) }}
{{- "Service" | files.systemd_unit.directive(socket.service) }}
{{- extra(socket) }}

{% endif -%}

{% if unit_file.mount is defined -%}
{%- set mount = unit_file.mount -%}
[Mount]
{{- "What" | files.systemd_unit.directive(mount.what) }}
{{- "Where" | files.systemd_unit.directive(mount.where) }}
{{- "Type" | files.systemd_unit.directive(mount.type) }}
{{- "Options" | files.systemd_unit.directive(mount.options) }}
{{- "SloppyOptions" | files.systemd_unit.directive(mount.sloppy_options) }}
{{- "LazyUnmount" | files.systemd_unit.directive(mount.lazy_unmount) }}
{{- "ReadWriteOnly" | files.systemd_unit.directive(mount.read_write_only) }}
{{- "ForceUnmount" | files.systemd_unit.directive(mount.force_unmount) }}
{{- "DirectoryMode" | files.systemd_unit.directive(mount.directory_mode) }}
{{- "TimeoutSec" | files.systemd_unit.directive(mount.timeout_sec) }}
{{- extra(mount) }}

{% endif -%}

{%- if unit_file.install is defined -%}
{%- set install = unit_file.install -%}
[Install]
{{- "Alias" | files.systemd_unit.directive(install.alias, joined=true) }}
{{- "WantedBy" | files.systemd_unit.directive(install.wanted_by) }}
{{- "RequiredBy" | files.systemd_unit.directive(install.required_by) }}
{{- extra(install) }}

{% endif -%}
