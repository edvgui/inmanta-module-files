{#- Write one "key=value" line per value (none is skipped), or a single line with all the values separated by spaces if joined is true -#}
{%- macro directive(key, value, joined=false, quoted_words=false) %}
{%- set values = [] if value is none else ([value] if value is string or value is not iterable else value) %}
{%- if joined and value is not none %}
{{ key }}={% for item in values %}{{ item | files.systemd_unit.word(key) if quoted_words else item | files.systemd_unit.raw(key) }}{{ " " if not loop.last }}{% endfor %}
{%- elif not joined %}
{%- for item in values %}
{{ key }}={{ item | files.systemd_unit.raw(key) }}
{%- endfor %}
{%- endif %}
{%- endmacro %}

{#- Write the free-form directives of a section -#}
{%- macro extra(section) %}
{#- Index the dict instead of using items(), to get null values converted to none -#}
{%- for key in section.extra %}
{{- directive(key, section.extra[key]) }}
{%- endfor %}
{%- endmacro %}

{%- if unit_file.unit is defined -%}
{%- set unit = unit_file.unit -%}
[Unit]
{{- directive("Description", unit.description) }}
{{- directive("Documentation", unit.documentation, joined=true) }}
{{- directive("RequiresMountsFor", unit.requires_mounts_for, joined=true, quoted_words=true) }}
{{- directive("Requires", unit.requires) }}
{{- directive("Wants", unit.wants) }}
{{- directive("BindsTo", unit.binds_to) }}
{{- directive("Conflicts", unit.conflicts) }}
{{- directive("Before", unit.before) }}
{{- directive("After", unit.after) }}
{{- directive("PartOf", unit.part_of) }}
{{- directive("OnFailure", unit.on_failure, joined=true) }}
{{- directive("StartLimitIntervalSec", unit.start_limit_interval_sec) }}
{{- directive("StartLimitBurst", unit.start_limit_burst) }}
{{- extra(unit) }}

{% endif -%}

{%- if unit_file.service is defined -%}
{%- set service = unit_file.service -%}
[Service]
{%- for name in service.environment %}
Environment={{ name | files.systemd_unit.environment(service.environment[name]) }}
{%- endfor %}
{{- directive("EnvironmentFile", service.environment_file) }}
{{- directive("User", service.user) }}
{{- directive("Group", service.group) }}
{{- directive("WorkingDirectory", service.working_directory) }}
{{- directive("Restart", service.restart) }}
{{- directive("TimeoutStartSec", service.timeout_start_sec) }}
{{- directive("TimeoutSec", service.timeout_sec) }}
{{- directive("TimeoutStopSec", service.timeout_stop_sec) }}
{{- directive("RestartSec", service.restart_sec) }}
{{- directive("ExecStartPre", service.exec_start_pre) }}
{{- directive("ExecStart", service.exec_start) }}
{{- directive("ExecStartPost", service.exec_start_post) }}
{{- directive("ExecReload", service.exec_reload) }}
{{- directive("ExecStop", service.exec_stop) }}
{{- directive("ExecStopPost", service.exec_stop_post) }}
{{- directive("Type", service.type) }}
{{- directive("RemainAfterExit", service.remain_after_exit) }}
{{- directive("NotifyAccess", service.notify_access) }}
{{- directive("PIDFile", service.pid_file) }}
{{- directive("KillMode", service.kill_mode) }}
{{- directive("SuccessExitStatus", service.success_exit_status or none, joined=true) }}
{{- extra(service) }}

{% endif -%}

{% if unit_file.timer is defined -%}
{%- set timer = unit_file.timer -%}
[Timer]
{{- directive("OnCalendar", timer.on_calendar) }}
{{- directive("OnBootSec", timer.on_boot_sec) }}
{{- directive("OnUnitActiveSec", timer.on_unit_active_sec) }}
{{- directive("AccuracySec", timer.accuracy_sec) }}
{{- directive("RandomizedDelaySec", timer.randomized_delay_sec) }}
{{- directive("Persistent", timer.persistent) }}
{{- directive("Unit", timer.unit) }}
{{- extra(timer) }}

{% endif -%}

{% if unit_file.socket is defined -%}
{%- set socket = unit_file.socket -%}
[Socket]
{{- directive("ListenStream", socket.listen_stream) }}
{{- directive("ListenDatagram", socket.listen_datagram) }}
{{- directive("Accept", socket.accept) }}
{{- directive("SocketMode", socket.socket_mode) }}
{{- directive("Service", socket.service) }}
{{- extra(socket) }}

{% endif -%}

{% if unit_file.mount is defined -%}
{%- set mount = unit_file.mount -%}
[Mount]
{{- directive("What", mount.what) }}
{{- directive("Where", mount.where) }}
{{- directive("Type", mount.type) }}
{{- directive("Options", mount.options) }}
{{- directive("SloppyOptions", mount.sloppy_options) }}
{{- directive("LazyUnmount", mount.lazy_unmount) }}
{{- directive("ReadWriteOnly", mount.read_write_only) }}
{{- directive("ForceUnmount", mount.force_unmount) }}
{{- directive("DirectoryMode", mount.directory_mode) }}
{{- directive("TimeoutSec", mount.timeout_sec) }}
{{- extra(mount) }}

{% endif -%}

{%- if unit_file.install is defined -%}
{%- set install = unit_file.install -%}
[Install]
{{- directive("Alias", install.alias, joined=true) }}
{{- directive("WantedBy", install.wanted_by) }}
{{- directive("RequiredBy", install.required_by) }}
{{- extra(install) }}

{% endif -%}
